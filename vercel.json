{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/health", "destination": "/api/index.ts" },
    { "source": "/admin/((?!assets/|.*\\.).*)", "destination": "/admin/index.html" },
    { "source": "/((?!api/|health|admin/|assets/|.*\\.).*)", "destination": "/index.html" }
  ]
}
